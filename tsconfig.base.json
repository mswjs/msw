{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strictNullChecks": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": false,
    "verbatimModuleSyntax": true
  },
  "include": ["./global.d.ts"],
  "exclude": ["node_modules", "lib"]
}
